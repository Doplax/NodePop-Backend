# También se acepta MONGODB_URI. En Windows usa 127.0.0.1 en vez de localhost:
# localhost resuelve primero a ::1 y Mongo escucha sólo en IPv4.
DB_URI=mongodb://127.0.0.1:27017/nodepop
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=24h
PORT=4500
PUBLIC_BASE_URL=http://localhost:4500
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

EMAIL_SERVICE_FROM=admin@example.com
EMAIL_SERVICE_NAME=sendgrid
EMAIL_SERVICE_USER=user
EMAIL_SERVICE_PASS=pass

RABBITMQ_BROKER_URL=amqps://example
